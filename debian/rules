#!/usr/bin/make -f
# Plain file installation (no setuptools needed, so it builds on older releases too).
PKG := debian/monctl

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	QT_QPA_PLATFORM=offscreen python3 -m pytest -q -p no:cacheprovider tests
endif

override_dh_auto_install:
	install -d $(PKG)/usr/lib/python3/dist-packages $(PKG)/usr/bin
	cp -r monctl $(PKG)/usr/lib/python3/dist-packages/
	find $(PKG) -name __pycache__ -prune -exec rm -rf {} +
	printf '#!/usr/bin/python3\nfrom monctl.cli import main\nraise SystemExit(main())\n' > $(PKG)/usr/bin/monctl
	chmod 755 $(PKG)/usr/bin/monctl
	./install-files.sh $(PKG)
	# Debian keeps the license as /usr/share/doc/monctl/copyright and installs the changelog itself
	rm -rf $(PKG)/usr/share/licenses $(PKG)/usr/share/doc/monctl/CHANGELOG.md

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
