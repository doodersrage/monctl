# Maintainer: Robert McDowell <1476679+doodersrage@users.noreply.github.com>
pkgname=monctl-msi
_name=monctl
pkgver=0.6.0
pkgrel=1
pkgdesc="Monitor control: per-game profiles, tray, DDC/CI brightness and MSI OSD settings over USB"
arch=('any')
url="https://github.com/doodersrage/monctl"
license=('MIT')
provides=('monctl')
conflicts=('monctl')
depends=('python' 'ddcutil')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pyqt6')
optdepends=('python-pyqt6: tray icon and window'
            'python-dbus: keyboard shortcuts, focus rules'
            'python-gobject: keyboard shortcuts, focus rules'
            'msigd: MSI monitor settings over USB (needs a build that knows your model)')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f98419f5e8b3cfc85ccfaea2c5abf8d6bfd24da2f74f8325cbb47cef1e899c7d')

build() {
  cd "$_name-$pkgver"
  /usr/bin/python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver"
  QT_QPA_PLATFORM=offscreen /usr/bin/python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$_name-$pkgver"
  /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
  ./install-files.sh "$pkgdir"
  # the license directory follows the package name
  mv "$pkgdir/usr/share/licenses/monctl" "$pkgdir/usr/share/licenses/$pkgname"
}
